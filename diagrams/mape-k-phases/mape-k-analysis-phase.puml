@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title MAPE-K Analysis Phase\n(Focused Sub-Process)

start

partition "MAPE-K : Analyze" {
    :Evaluate current state\nagainst adaptation goals;
    note right
      (4) Monitor forwards
      data to Analyzer
    end note

    if (Goals violated\nor at risk?) then (yes)
        :Trigger adaptation;
        note right
          (5) Analyzer notifies
          Adaptation Option Predictor
        end note
    else (no)
        :No adaptation required;
        note right
          Continue normal
          operation
        end note
    endif
}

stop

@enduml
