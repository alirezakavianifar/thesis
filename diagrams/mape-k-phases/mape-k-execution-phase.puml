@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title MAPE-K Execution Phase\n(Focused Sub-Process)

start

partition "MAPE-K : Execute" {
    :Executor retrieves adaptation details;
    note right
      (8) Executor retrieves
      adaptation option details
      from Knowledge repository
    end note

    :Executor applies adaptation\nto managed system;
    note right
      (9) Adaptation executed
      on managed system
    end note
}

note right
  Enacts adaptation decision,
  translating option into
  concrete modifications
end note

stop

@enduml
