@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title Experience Storage and Replay Buffer Management\n(Focused Sub-Process)

start

partition "Replay Memory" {
    :Store experience\n<s_t, a_t, r_t, s_t+1>;
    note right
      Add new experience
      to replay buffer
    end note
    
    if (Replay buffer\nsufficiently full?) then (yes)
        :Sample minibatch B;
        note right
          Random sampling enables
          diverse learning and breaks
          correlation between samples
        end note
    else (no)
        :Continue interaction;
        note right
          Collect more experience
          before learning
        end note
    endif
}

stop

@enduml
