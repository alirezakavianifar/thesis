@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title Adaptation Option Prediction Process\n(Runtime Decision Path – Stages 5-7 traceable to Figure 2)

start

partition "MAPE-K : Analyze" {
    :Detect goal violation\nor risk;
    note right
      (5) Analyzer notifies
      Adaptation Option Predictor
    end note
}

partition "MAPE-K : Plan\n(Adaptation Option Predictor)" {
    :Receive current state vector;

    :Retrieve trained RS-DRL model\nfrom Knowledge repository;
    note right
      (6) Trained model retrieved
    end note

    :Evaluate Q-values\nfor all adaptation options;

    :Select best adaptation option\n(argmax Q or ε-greedy);
    note right
      (7) Adaptation option
      predicted.
      Runtime: ε ≈ 0
      (pure exploitation)
    end note
}

stop

@enduml

