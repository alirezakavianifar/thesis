@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title Data Acquisition and Preprocessing\n(Focused Sub-Process)

start

partition "Managed System & Environment" {
    :Generate raw runtime data;
    note right
      (1) Runtime data produced
      by managed system
    end note
}

partition "MAPE-K : Monitor\n(Data Acquisition)" {
    :Collect raw metrics\n(system & environment);
    note right
      Sensor readings,
      system logs,
      environment data
    end note
}

partition "Data Preprocessing" {
    :Filter noise;
    note right
      Remove outliers
      and invalid readings
    end note
    
    :Normalize values;
    note right
      Scale features to
      common range
    end note
    
    :Handle missing data;
    note right
      Imputation or
      exclusion strategies
    end note
}

note right
  Uncertainty reduction
  and stabilization
end note

stop

@enduml
