@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title Integrated RS-DRL–Based Self-Adaptive System\n(Composition of Diagrams 1–5)

start

partition "Managed System & Environment" {
    :Execute system behavior;
    :Generate runtime data;
    note right
      (1) Runtime data produced
    end note
}

partition "Monitoring & State Construction\n(Diagram 5)" {
    :Collect raw data;
    :Preprocess & filter;
    :Extract features;
    :Construct state vector s_t;
    note right
      (2) State forwarded
      to RS-DRL
      (4) State forwarded
      to Analyzer
    end note
}

partition "MAPE-K : Analyze\n(Diagram 3)" {
    :Evaluate goals & QoS;
    if (Goals violated or at risk?) then (yes)
        :Trigger adaptation;
        note right
          (5) Analyzer notifies
          Adaptation Option Predictor
        end note
    else (no)
        :Continue normal operation;
    endif
}

if (Goals violated or at risk?) is (no) then
    :Execute system behavior;
    note right
      Loop back to normal
      operation when no
      adaptation needed
    end note
endif

partition "MAPE-K : Plan\n(Diagram 2)" {
    :Invoke Adaptation Option Predictor;
    :Retrieve trained RS-DRL model;
    note right
      (6) Model retrieved
    end note

    :Predict best adaptation option;
    note right
      (7) Option predicted
    end note
}

partition "Adaptation Option Verification\n(Diagram 4)" {
    :Parameterize runtime model;
    :Run UPPAAL-SMC;
    :Estimate QoS & uncertainty;
    :Generate evaluation feedback;
}

partition "RS-DRL Training\n(Diagram 1)" {
    :Receive state & evaluation feedback;
    :Store experience;
    :Apply reward shaping;
    :Update DQN model;
    :Store updated model;
    note right
      (3) Model stored
      in Knowledge repository
    end note
}

partition "MAPE-K : Execute\n(Diagram 3)" {
    :Retrieve adaptation details;
    note right
      (8) Adaptation details retrieved
    end note

    :Apply adaptation;
    note right
      (9) Adaptation executed
    end note
}

partition "Managed System & Environment" {
    :System behavior changes;
    :Environment reacts;
}

:Execute system behavior;
note right
  Loop back after
  adaptation execution
end note

stop

@enduml

