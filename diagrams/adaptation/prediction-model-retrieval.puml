@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title Model Retrieval and Evaluation\n(Focused Sub-Process)

start

partition "MAPE-K : Plan\n(Adaptation Option Predictor)" {
    :Receive current state vector;
    note right
      State from Monitor
      (same representation
      used during training)
    end note
    
    :Retrieve trained RS-DRL model\nfrom Knowledge repository;
    note right
      (6) Trained model retrieved
      from Knowledge repository
    end note
    
    :Evaluate Q-values\nfor all adaptation options;
    note right
      DQN estimates Q(s, a)
      for each available option
    end note
}

note right
  Leverages knowledge learned
  during training episodes
end note

stop

@enduml
