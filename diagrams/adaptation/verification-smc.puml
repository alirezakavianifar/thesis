@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title Statistical Model Checking\n(Focused Sub-Process)

start

partition "UPPAAL-SMC Engine" {
    :Execute probabilistic\nsimulations;
    note right
      Explores different
      execution paths and
      environmental conditions
    end note
    
    :Estimate goal satisfaction\nprobabilities;
    note right
      Statistical analysis of
      multiple simulation runs
    end note
}

note right
  Handles uncertainty by
  considering multiple
  possible futures
end note

stop

@enduml
