@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title Quality Evaluation and Feedback\n(Focused Sub-Process)

start

partition "Quality Evaluation" {
    :Extract QoS metrics;
    note right
      Energy consumption,
      packet loss, latency, etc.
    end note
    
    :Aggregate metrics\ninto quality score;
    note right
      Combined measure of
      adaptation effectiveness
    end note
}

partition "Reward / Feedback Interface" {
    if (Invoked during training?) then (yes)
        :Generate reward value;
        note right
          Guides RS-DRL
          learning process
        end note
    else (no)
        :Generate quality estimate;
        note right
          Justifies adaptation
          decision at runtime
        end note
    endif
}

stop

@enduml
