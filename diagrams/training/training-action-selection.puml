@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title Action Selection and Environment Interaction\n(Focused Sub-Process)

start

partition "Action Selection" {
    :Select action a_t\n(ε-greedy using Q-network);
    note right
      With probability ε: random action
      With probability 1-ε: argmax Q(s,a)
    end note
}

partition "Environment Interaction" {
    :Execute action a_t;
    note right
      Apply selected adaptation
      option to managed system
    end note
    
    :Observe reward r_t;
    note right
      Reward computed by
      Adaptation Option Verifier
    end note
    
    :Observe next state s_t+1;
    note right
      New state after
      adaptation execution
    end note
}

note right
  Generates experience tuple
  <s_t, a_t, r_t, s_t+1>
end note

stop

@enduml
