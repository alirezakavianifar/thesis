@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title State Dissemination\n(Focused Sub-Process)

start

partition "State Dissemination" {
    :Send state vector\nto Analyzer;
    note right
      (4) State forwarded
      to Analyzer for
      goal evaluation
    end note

    :Send state vector\nto RS-DRL module;
    note right
      (2) State forwarded
      to RS-DRL for
      learning/prediction
    end note

    :Store state history\nin Knowledge repository;
    note right
      Historical reference
      for future analysis
    end note
}

stop

@enduml
