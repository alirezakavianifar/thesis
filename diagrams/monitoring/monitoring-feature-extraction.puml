@startuml
!define DPI 300
skinparam dpi 300
skinparam defaultFontSize 12
skinparam maxMessageSize 200
skinparam activity {
    BackgroundColor #E1F5FE
    BorderColor #01579B
    FontSize 11
}
skinparam partition {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontSize 12
    FontStyle bold
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F57F17
}
skinparam padding 20
skinparam minClassWidth 0
skinparam minClassHeight 0
skinparam shadowing false
title Feature Extraction and State Construction\n(Focused Sub-Process)

start

partition "Feature Extraction" {
    :Derive goal-relevant features;
    note right
      Extract attributes that
      capture essential
      performance metrics
    end note
    
    :Reduce dimensionality;
    note right
      Transform to lower-dimensional
      feature space
    end note
}

partition "State Construction" {
    :Assemble state vector s_t;
    note right
      Combine extracted features
      into unified representation
    end note
    
    :Validate feature bounds;
    note right
      Ensure values within
      expected ranges
    end note
}

note right
  Interface contract between
  Monitoring and Learning/Prediction
end note

stop

@enduml
